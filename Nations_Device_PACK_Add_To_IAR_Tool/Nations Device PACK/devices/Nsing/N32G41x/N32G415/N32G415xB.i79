[FILEFORMAT]
rev=1.6

[CHIP]
//Chip name
name=N32G415xB

//What endian modes does the chip support? (le_be8_be32(default), le_be8, le_be32, le, be8_be32, be8, be32)
endiansupport=le

//Does the chip support the thumb instruction set? (true(default), false)
thumbsupport=true

//Does the chip support the arm instruction set? (true(default), false)
armsupport=false

//Does the chip have an FPU coprocessor?
fpu=false

SIMD=false

//Chip specific macros, e.g. for initialization of trace mechanisms
ProbeScriptFile=$TOOLKIT_DIR$\config\debugger\Nsing\N32.ProbeScript
DeviceMacros=$TOOLKIT_DIR$\config\debugger\Nsing\N32G41x\N32G41x.dmac

//Debugger interface, default JTAG=true, RTCK=true, SWD=true if Cortex cores, SWD=false if ARM cores, SWO_TraceD0=false
JTAG=false
RTCK=false
SWD=true
SWO_TraceD0=false

[CORE]
name=Cortex-M4

[DDF FILE]
name=Nsing\N32G41x\N32G415xB.ddf

[LINKER FILE]
name=$TOOLKIT_DIR$\config\linker\Nsing\N32G41x\N32G415xB.icf

[FLASH LOADER]
little=$TOOLKIT_DIR$\config\flashloader\Nsing\N32G41xxB\N32G41xxB.board

