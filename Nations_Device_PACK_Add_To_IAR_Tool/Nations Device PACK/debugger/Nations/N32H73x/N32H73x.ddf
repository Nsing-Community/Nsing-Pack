;; Architecture extensions
;;#include weak "..\..\ARM\ARMv7-M-ETM.ddf"
#include weak "..\..\ARM\ARMv7-M-TPIU.ddf"
#include weak "..\..\ARM\ARMv7-M-MPU.ddf"

;; Memory information ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; 
;; Used to define address zones within the ARM address space (Memory). 
;;
;;   Name      may be almost anything
;;   AdrSpace  must be Memory
;;   StartAdr  start of memory block
;;   EndAdr    end of memory block
;;   AccType   type of access, read-only (R), read-write (RW) or SFR (W)

[Memory]
;;         Name             AdrSpace    StartAdr    EndAdr      AccType   Width
Memory =  ITCM-RAM         Memory      0x00000000  0x0007FFFF  R
Memory =  SIPFlash         Memory      0x15000000  0x151DFFFF  R 
Memory =  SysMem1          Memory      0x1FF00000  0x1FF1BFFF  R  
Memory =  OptionsROM       Memory      0x1FFF8000  0x1FFF9FFF  R 
Memory =  DTCM-RAM         Memory      0x20000000  0x2007FFFF  RW  
Memory =  RAM1_AXI         Memory      0x24000000  0x2401FFFF  RW
Memory =  RAM2_AXI         Memory      0x24020000  0x2409FFFF  RW
Memory =  BackupRAM        Memory      0x38000000  0x38000FFF  RW
Memory =  PeriphAPB1       Memory      0x40000000  0x400AFFFF  W 
Memory =  PeriphAHB9       Memory      0x400B0000  0x400CFFFF  W 
Memory =  PeriphAPB2       Memory      0x400D0000  0x400EFFFF  W  
Memory =  PeriphAHB2       Memory      0x400F0000  0x4FFFFFFF  W  
Memory =  PeriphAPB6       Memory      0x50000000  0x50FFFFFF  W  
Memory =  PeriphAHB6       Memory      0x51000000  0x57FFFFFF  W  
Memory =  PeriphAPB5       Memory      0x58000000  0x5802FFFF  W  
Memory =  PeriphAHB5       Memory      0x58030000  0x5FFFFFFF  W  
Memory =  ExtDev0          Memory      0x60000000  0x9FFFFFFF  W
Memory =  ExtDev1          Memory      0xC0000000  0xDFFFFFFF  W  
Memory =  SystemSFR        Memory      0xE0000000  0xE00FFFFF  W 

TrustedRanges = true
UseSfrFilter = true

[SfrInclude]
File = N32H73x.svd

