            <value>24</value>
        </interrupt>
        <interrupt>
            <name>ATIM1_UP</name>
            <description>ATIM1 update interrupt</description>
            <value>25</value>
        </interrupt>
        <interrupt>
            <name>ATIM1_TRG_COM</name>
            <description>ATIM1 trigger and commutation interrupt</description>
            <value>26</value>
        </interrupt>
        <interrupt>
            <name>ATIM1_CC</name>
            <description>ATIM1 capture compare interrupt</description>
            <value>27</value>
        </interrupt>
